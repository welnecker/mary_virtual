# Opcional: modelo usado apenas para compactar a memória canônica.
# Se omitido, usa o mesmo modelo selecionado para Mary.
MARY_MEMORY_MODEL = ""

# Opcional: modelo usado pelo Diretor de Cena.
# Se omitido, usa o mesmo modelo selecionado para Mary.
MARY_DIRECTOR_MODEL = ""


# Persistência em Google Sheets
# Reutiliza o secret já existente no projeto.
GOOGLE_CREDS_JSON = """{
  "type": "service_account",
  "project_id": "seu-projeto",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "conta@seu-projeto.iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}"""

