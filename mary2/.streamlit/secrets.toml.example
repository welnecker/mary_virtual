# Copie este arquivo para .streamlit/secrets.toml apenas na sua máquina
# ou configure os mesmos secrets no painel do Streamlit Community Cloud.
# NUNCA faça commit do secrets.toml real.

OPENROUTER_API_KEY = "sua-chave-aqui"

# Opcional
MARY_DEFAULT_MODEL = "anthropic/claude-sonnet-5.5"
MARY_FALLBACK_MODEL = ""

# Opcional: modelo usado apenas para compactar a memória canônica.
# Se omitido, usa o mesmo modelo selecionado para Mary.
MARY_MEMORY_MODEL = ""

# Opcional: modelo usado pelo Diretor de Cena.
# Se omitido, usa o mesmo modelo selecionado para Mary.
MARY_DIRECTOR_MODEL = ""


# Persistência em Google Sheets
# MARY_SHEETS_ID é opcional. Se ficar vazio, o app cria/abre uma planilha
# pelo título abaixo usando a service account.
MARY_SHEETS_ID = ""
MARY_SHEETS_TITLE = "MARY_CORE_PERSISTENCE"
MARY_PLAYER_ID = "janio"

# Opcional: se informado, o app tenta compartilhar a planilha criada
# com este e-mail como editor.
MARY_SHEETS_OWNER_EMAIL = ""

# Credencial Google da service account.
# No Streamlit Community Cloud, cole os campos reais em Secrets.
[GOOGLE_SERVICE_ACCOUNT]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "conta@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
