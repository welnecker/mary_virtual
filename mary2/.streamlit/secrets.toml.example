# Copie este arquivo para .streamlit/secrets.toml apenas na sua máquina
# ou configure os mesmos secrets no painel do Streamlit Community Cloud.
# NUNCA faça commit do secrets.toml real.

OPENROUTER_API_KEY = "sua-chave-aqui"

# Opcional
MARY_DEFAULT_MODEL = "anthropic/claude-sonnet-5.5"
MARY_FALLBACK_MODEL = ""

# Opcional: modelo usado apenas para compactar a memória canônica.
# Se omitido, usa o mesmo modelo selecionado para Mary.
MARY_MEMORY_MODEL = ""

# Opcional: modelo usado pelo Diretor de Cena.
# Se omitido, usa o mesmo modelo selecionado para Mary.
MARY_DIRECTOR_MODEL = ""


# Persistência opcional em Google Sheets
MARY_SHEETS_ID = "id-da-planilha"
MARY_PLAYER_ID = "janio"

# Cole aqui o JSON da service account como objeto TOML.
# Exemplo:
# [GOOGLE_SERVICE_ACCOUNT]
# type = "service_account"
# project_id = "seu-projeto"
# private_key_id = "..."
# private_key = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"""
# client_email = "conta@projeto.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
